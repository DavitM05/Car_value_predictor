# Copy this file to .env and adjust values before running docker-compose up --build

# ---- MySQL ----
DB_ROOT_PASSWORD=rootpassword
DB_NAME=car_price_db
DB_USER=car_user
DB_PASSWORD=car_password

# ---- External ML model server ----
# The FastAPI backend proxies prediction requests to this URL.
MODEL_SERVER_URL=https://example-model-server.com/api/predict

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
REACT_APP_API_URL=http://localhost:8000
